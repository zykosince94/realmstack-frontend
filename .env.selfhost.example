# Copy to .env.selfhost, fill in the values, then:
#   docker compose -f docker-compose.selfhost.yml --env-file .env.selfhost up -d --build --wait
#
# Never commit the filled file. Use your platform's secret store in production.

# Public port for the web container. Put TLS and your hostname in front of it.
WEB_PORT=8080

# PostgreSQL 17 (external to the Compose file).
DATABASE_URL=postgres://realmstack:replace-me@db.example.com:5432/realmstack?sslmode=require
# Direct connection for migrations/operator commands when DATABASE_URL uses PgBouncer.
DATABASE_DIRECT_URL=postgres://realmstack:replace-me@db.example.com:5432/realmstack?sslmode=require
# Optional lag-tolerant read replica.
DATABASE_REPLICA_URL=

# At least 32 random characters: openssl rand -base64 48. The API refuses to start while this
# is still the placeholder below. Rotating it signs everyone out.
JWT_SECRET=replace-with-at-least-32-random-characters

# Proxy addresses allowed to supply X-Forwarded-For. Leave empty when no proxy is trusted.
TRUSTED_PROXIES=

# Optional leaderboard rank projection. Set on every API instance or leave empty.
# To use the bundled Redis, start the stack with `--profile redis` and set
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=

# Optional AI assistant. Generate with: openssl rand -base64 32
AI_ENCRYPTION_KEY=
AI_ALLOW_PRIVATE_URLS=false
