# Copy to .env for local overrides only. Defaults are disposable demo values.
POSTGRES_DB=realmstack
POSTGRES_USER=realmstack
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5434
JWT_SECRET=local-only-change-this-secret-before-deploying
DEMO_MODE=true
API_PORT=8080
WEB_PORT=5174
# Optional AI assistant (bring your own OpenAI key). Unset = AI disabled; everything else works.
# A base64-encoded 32-byte key that encrypts users' provider keys at rest. Generate one with
#   openssl rand -base64 32
# or in PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
# Changing it makes stored provider keys unreadable (users re-enter them).
AI_ENCRYPTION_KEY=
# Providers: OpenAI, or any OpenAI-compatible service (OpenRouter, Groq, Ollama...) at a base URL
# set in the dashboard. Base URLs must be https and public unless you set this to true, which
# also allows http and private addresses (for a local model server). Leave false otherwise.
AI_ALLOW_PRIVATE_URLS=false
