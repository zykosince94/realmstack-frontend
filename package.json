{
  "name": "realmstack-frontend",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "generate:api": "openapi-typescript ../realmstack-backend/api/openapi.yaml -o src/api/generated/schema.ts",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "check:openapi": "node scripts/sync-openapi.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-query": "5.66.0",
    "@xyflow/react": "12.12.0",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "0.13.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.0.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.6.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.46.2",
    "vite": "^7.3.8",
    "vitest": "4.1.12"
  }
}
